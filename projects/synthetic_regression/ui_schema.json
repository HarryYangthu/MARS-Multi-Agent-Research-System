{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mars.synthetic_regression.ui.v1",
  "title": "Synthetic Regression Discovery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["config-only", "mock", "synthetic"],
      "default": "mock"
    },
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 20, "default": 20},
    "seed": {"type": "integer", "default": 0},
    "fidelity": {"type": "string", "enum": ["F0", "F1"], "default": "F0"}
  },
  "required": ["mode", "candidate_count", "seed", "fidelity"]
}
