{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mars://schemas/code_spec.v1.json",
  "title": "Coding Agent code_spec frontmatter",
  "type": "object",
  "required": [
    "schema",
    "project",
    "agent",
    "target_lang",
    "baseline_compat",
    "files_changed"
  ],
  "additionalProperties": true,
  "properties": {
    "experiment_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "const": "code_spec.v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "const": "coding"
    },
    "upstream_artifact": {
      "type": "string"
    },
    "target_lang": {
      "enum": [
        "python",
        "c",
        "cpp",
        "rust"
      ]
    },
    "baseline_compat": {
      "type": "object",
      "required": [
        "preserved"
      ],
      "properties": {
        "preserved": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "modified",
              "added",
              "deleted",
              "renamed"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "new_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_coverage": {
      "type": "object",
      "properties": {
        "unit_tests_added": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_smoke_test": {
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        }
      }
    },
    "execution_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "config"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "config": {
            "type": "object",
            "properties": {
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "command_id": {
                "type": "string",
                "minLength": 1
              },
              "budget_unit": {
                "enum": [
                  "steps",
                  "epochs"
                ]
              },
              "max_iters": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
