{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "human_summary",
    "gaps",
    "selection_principles",
    "sources",
    "insights"
  ],
  "properties": {
    "schema": {
      "const": "research_report.v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "human_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection_principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "title",
          "decision",
          "selection_reason",
          "gap_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "use",
              "reject",
              "defer"
            ]
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "gap_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "insights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "read_receipt",
          "document_sha256",
          "page",
          "quote",
          "paper_finding",
          "transfer_idea",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "read_receipt": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          },
          "paper_finding": {
            "type": "string",
            "minLength": 1
          },
          "transfer_idea": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
