# MARS 启动环境：每行 KEY=VALUE，# 开头是注释。mars / mars-app / mars-check / mars-python 启动时读取；
# 系统里已经设置的同名环境变量优先。安装脚本把本文件复制成 code/mars-deploy/local/mars.env，不会覆盖已有文件。

# ---- 代理：只有公网论文 API（arXiv / OpenAlex / Crossref / doi.org）需要 ----
# 内网地址、本机和模型网关必须写进 NO_PROXY，否则模型请求也会走代理。127.0.0.1 和 localhost 会被自动补上。
# HTTPS_PROXY=http://proxy.example.corp:8080
# HTTP_PROXY=http://proxy.example.corp:8080
# NO_PROXY=.example.corp,10.0.0.0/8
NO_PROXY=127.0.0.1,localhost,::1
# DDGS_PROXY=http://proxy.example.corp:8080

# ---- 编码 Agent 沙箱 ----
# Windows 普通用户只能限制 Agent 的写入（低完整性级别），不能限制网络，因为网络隔离需要管理员权限。
# 确认接受这一点后取消下一行的注释，否则 Step2 的 CodingAgent 不会启动。
# MARS_SANDBOX_WINDOWS_NETWORK=unrestricted
# Linux：auto（默认，优先 bubblewrap，不可用时退到 Landlock）| bwrap | landlock
# MARS_SANDBOX_LINUX=auto
# Linux 内核早于 6.7 且 bubblewrap 不可用时，Landlock 只能限制写入；确认接受后取消下一行注释
# MARS_SANDBOX_LINUX_NETWORK=unrestricted

# ---- mars-app：只监听 127.0.0.1，没有鉴权，不要改成对外监听 ----
# MARS_APP_PORT=8020
