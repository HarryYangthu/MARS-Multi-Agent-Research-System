{
  "name": "mars-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "node scripts/clean-next-types.cjs && tsc --noEmit",
    "test:context": "tsc --outDir .tmp/context-workbench --rootDir . --module commonjs --target ES2022 --moduleResolution node --skipLibCheck --noEmit false scripts/context-workbench-smoke.ts src/lib/contextWorkbench.ts && node .tmp/context-workbench/scripts/context-workbench-smoke.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@uiw/react-md-editor": "^4.0.4",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.50.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.1",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
