# MARS V3.1 Windows Docker local settings.
# Start-Mars.ps1 copies this file to .env on first launch. Never commit .env.

# Host ports (loopback only).
MARS_FRONTEND_PORT=3001
MARS_BACKEND_PORT=8000

# Docker Desktop must run Linux containers. Huawei Windows x64 uses amd64.
MARS_DOCKER_PLATFORM=linux/amd64
MARS_BACKEND_IMAGE=mars-v31-backend:windows-amd64
MARS_FRONTEND_IMAGE=mars-v31-frontend:windows-amd64
MARS_REDIS_IMAGE=redis:7.4-alpine
MARS_PYTHON_IMAGE=python:3.11-slim-bookworm
MARS_NODE_IMAGE=node:20-alpine
MARS_NPM_REGISTRY=https://registry.npmjs.org

# Optional absolute Windows path. If empty, Start-Mars.ps1 looks for a sibling
# directory named mars_v31_wireless next to mars_v2.
MARS_V31_OVERLAY_PATH=

# The CPU image includes the bundled StaticPIMC Alpha dependencies by default.
# Set to 0 only for a smaller mock-only image.
MARS_INSTALL_STATIC_ALPHA=1
MARS_TORCH_VERSION=2.12.1
# May point to a company-approved mirror. The image build still verifies the
# downloaded wheel against the pinned official per-architecture SHA256.
MARS_TORCH_WHEEL_BASE_URL=https://download.pytorch.org/whl/cpu
MARS_UV_VERSION=0.11.1
# Keep enabled in release images; local maintainers may disable it only for a
# mock container smoke when their image mirror is temporarily unavailable.
MARS_INSTALL_SYSTEM_TOOLS=1

# Safe first-run defaults. The production launcher overrides runtime/mock mode.
MARS_RUNTIME_MODE=development
MARS_MOCK_MODE=auto
MARS_EXECUTION_DEVICE=cpu
MARS_EXECUTION_BACKEND=mock

# Optional DeepSeek credentials. Keep this local file private. Leave the key
# assignment COMMENTED when managing it through the UI: even an empty process
# environment value overrides the persisted runtime/.env.local after restart.
# An uncommented value here is authoritative over keys saved in the UI.
# DEEPSEEK_API_KEY=replace-with-your-approved-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Production-only read-only host mounts. Set absolute Windows paths before
# running start-mars-production.cmd.
PIMC_REPO_HOST_PATH=
PIMC_DATA_HOST_PATH=

# LLM calls may need several minutes when thinking mode is enabled.
MARS_LLM_TIMEOUT_SECONDS=120
MARS_LOG_LEVEL=INFO
