ARG MARS_NODE_IMAGE=node:20-alpine
ARG MARS_NPM_REGISTRY=https://registry.npmjs.org

FROM ${MARS_NODE_IMAGE} AS deps

ARG MARS_NPM_REGISTRY

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm config set registry "$MARS_NPM_REGISTRY" \
    && sed -i \
      -e "s#https://registry.npmjs.org#${MARS_NPM_REGISTRY%/}#g" \
      -e "s#https://registry.npmmirror.com#${MARS_NPM_REGISTRY%/}#g" \
      package-lock.json \
    && npm ci --legacy-peer-deps


FROM ${MARS_NODE_IMAGE} AS builder

ARG BACKEND_URL=http://backend:8000
ARG NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
ARG NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

ENV BACKEND_URL=$BACKEND_URL \
    NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend ./
RUN npm run build


FROM ${MARS_NODE_IMAGE} AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    HOME=/tmp/mars-home

RUN mkdir -p /tmp/mars-home \
    && chown -R node:node /tmp/mars-home

WORKDIR /app

COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "server.js"]
