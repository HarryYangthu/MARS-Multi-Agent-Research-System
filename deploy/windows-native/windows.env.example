# MARS V3.1 native Windows settings. This launcher does not use Docker or Redis.

MARS_FRONTEND_PORT=3001
MARS_BACKEND_PORT=8000

# Leave empty when mars_v31_wireless is next to mars_v2.
MARS_V31_OVERLAY_PATH=

# Safe first-run defaults.
MARS_RUNTIME_MODE=development
MARS_MOCK_MODE=auto
MARS_EXECUTION_DEVICE=cpu
MARS_EXECUTION_BACKEND=mock
MARS_CODING_BACKEND=mock

# Keep the key line commented when saving a key through the frontend.
# DEEPSEEK_API_KEY=replace-with-your-approved-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional company-approved package mirrors for the first installation.
MARS_PYTHON_INDEX_URL=
MARS_NPM_REGISTRY=

MARS_LLM_TIMEOUT_SECONDS=120
MARS_LOG_LEVEL=INFO
