# MARS V0 — environment variables
# Configure a real provider before running an Agent. Missing keys fail closed.

# === LLM API Keys ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional per-agent keys. The frontend config workbench can write these to
# .env.local and point configs/agents.yaml model.api_key_env at each one.
COMMANDER_DEEPSEEK_API_KEY=
IDEA_DEEPSEEK_API_KEY=
EXPERIMENT_DEEPSEEK_API_KEY=
CODING_DEEPSEEK_API_KEY=
EXECUTION_DEEPSEEK_API_KEY=
WRITING_DEEPSEEK_API_KEY=

# === Local backends ===
LOCAL_VLLM_BASE_URL=http://localhost:8001/v1
LOCAL_VLLM_API_KEY=EMPTY

# Coding Agent post-training endpoint (V0 load-only).
# Keep secrets out of configs/agents.yaml; reference this env var via api_key_env.
POST_TRAINING_CODING_ENDPOINT=http://127.0.0.1:8001/v1
POST_TRAINING_CODING_MODEL=mars-coding-posttrain

CUSTOM_ENDPOINT_URL=
CUSTOM_ENDPOINT_API_KEY=

# === Infrastructure ===
REDIS_URL=redis://localhost:6379/0
CHROMADB_PATH=./knowledge/.chromadb

# === Service ports ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Comma-separated browser origins allowed to call the backend.
# Use your Vercel/custom frontend domains in staging/production.
MARS_CORS_ORIGINS=*

# === Mode flags ===
# development | staging | production
MARS_RUNTIME_MODE=development
# Only never is supported; historical switches auto/always are rejected.
# Use staging + never for local real-LLM integration while keeping the
# execution backend configurable for demos.
# MARS_RUNTIME_MODE=staging
# MARS_MOCK_MODE=never
MARS_MOCK_MODE=never
# Source acquisition limits (network tools still require an explicit allowlist).
# Read timeout limits inactivity; download timeout limits one complete transfer.
# Total timeout covers the selected batch and extraction, at most 300 seconds.
# Size may be deliberately raised up to 64 MiB; partial downloads are not archived.
MARS_SOURCE_MAX_MIB=12
MARS_SOURCE_CONNECT_TIMEOUT_SECONDS=15
MARS_SOURCE_READ_TIMEOUT_SECONDS=30
MARS_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=180
MARS_SOURCE_TOTAL_TIMEOUT_SECONDS=240
MARS_SOURCE_MAX_ATTEMPTS=2
# cpu | gpu
# cpu runs Project Adapters locally through ProcessAdapter. gpu selects the
# fail-closed remote_gpu SSH adapter; no automatic CPU-to-GPU fallback occurs.
MARS_EXECUTION_DEVICE=cpu
# pim_cpu | paper_static | local_command | docker_command | remote_gpu
# remote_gpu remains a backwards-compatible alias when MARS_EXECUTION_DEVICE
# is absent. New deployments should select GPU with MARS_EXECUTION_DEVICE=gpu.
MARS_EXECUTION_BACKEND=local_command
# Optional override for configs/execution.yaml::execution.paper_static.python
MARS_PAPER_STATIC_PYTHON=/opt/anaconda3/bin/python

# === Generic SSH GPU executor (remote_job.v1) ===
# Connection values are read only from the environment. Keep the private key
# itself outside this repository and pin the server in a dedicated known_hosts.
MARS_REMOTE_ENABLED=false
MARS_REMOTE_SSH_HOST=
MARS_REMOTE_SSH_PORT=22
MARS_REMOTE_SSH_USER=
MARS_REMOTE_SSH_KEY_PATH=
MARS_REMOTE_SSH_KNOWN_HOSTS=
MARS_REMOTE_ROOT=
MARS_REMOTE_PYTHON=python3
# Comma-separated CUDA device identifiers, for example: 0 or 0,1.
MARS_REMOTE_GPU_IDS=

MARS_LOG_LEVEL=INFO
# Seconds before a real LLM call times out. Errors are recorded without fallback;
# production should set this high enough for the selected provider/model.
MARS_LLM_TIMEOUT_SECONDS=90
# Network-backed tools (arXiv/web) are implemented but off by default so the
# zero-dependency demo stays offline-safe.
MARS_ENABLE_NETWORK_TOOLS=false
MARS_WEB_SEARCH_ALLOWLIST=
# empty | zhipu | brave | tavily | serper
MARS_WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional MCP adapter health toggles. Agents still call MARS tool names.
MARS_MCP_CHROMA_ENABLED=false
MARS_MCP_CHROMA_COMMAND=
MARS_MCP_FILESYSTEM_COMMAND=
MARS_MCP_FILESYSTEM_ROOTS=
MARS_MCP_GIT_COMMAND=
MARS_MCP_GITHUB_ENABLED=false
MARS_MCP_GITHUB_COMMAND=

# === Context Engineering V1 ===
MARS_CONTEXT_MAX_TOKENS=32000
MARS_CONTEXT_TARGET_TOKENS=24000
MARS_CONTEXT_AUTO_COMPRESS=true
MARS_CONTEXT_TOOL_RAW_EXTERNALIZE=true
MARS_CONTEXT_WORKBENCH_ENABLED=true

# === Optional observability mirrors ===
# File-backed traces under runs/<id>/context stay mandatory. LangSmith is an
# external mirror only and is disabled by default.
MARS_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mars-dev
MARS_LANGSMITH_TIMEOUT_MS=1000

# === Project default ===
MARS_DEFAULT_PROJECT=pimc
