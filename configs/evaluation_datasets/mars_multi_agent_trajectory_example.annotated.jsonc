{ // 开始一条完整的 MARS 多 Agent 评测样本
  "schema": "mars_multi_agent_trajectory.v1", // 当前对象遵循的数据契约版本，用于选择正确的校验规则
  "sample_id": "synthetic.commander_repair.002", // 该评测样本的全局唯一编号
  "dataset_split": "validation", // 数据划分；validation 用于调参，不应作为最终密封测试集
  "synthetic": true, // 明确标记这是一条合成样本，不代表真实生产结果
  "project": "synthetic_regression", // 运行所使用的 Project Pack 名称
  "task_type": "commander_repair", // 任务类别；本例专门评测 Commander 失败归因与返工
  "provenance": { // 样本的来源、时间、隐私状态和人工审核情况
    "source": "handcrafted_synthetic", // 样本产生方式；这里是人工设计的合成轨迹
    "created_at": "2026-08-21T09:10:00Z", // 样本创建时间，采用 UTC ISO-8601 格式
    "contains_private_data": false, // 是否包含公司代码、真实业务数据或其他私密信息
    "annotation_status": "reviewed", // 标注状态；reviewed 表示已经过一次人工检查
    "limitations": [ // 该样本的适用边界和已知局限
      "The failure attribution and metrics are deterministic synthetic fixtures." // 当前列表中的一个具体值或 Artifact 引用
    ] // 结束当前列表；逗号表示后面还有同级内容
  }, // 结束当前结构化对象；逗号表示后面还有同级内容
  "input": { // 用户输入以及 Commander 归一化后的机器可执行任务契约
    "user_prompt": "优化合成回归候选：MAE 必须不高于 0.10，P95 延迟不高于 25 ms；最多允许两轮实验，如果第一轮失败，应根据证据只返工责任 Agent。", // 用户提交给 MARS 的原始自然语言需求
    "normalized_objective": "Meet quality and latency thresholds within two attempts using evidence-based repair routing.", // Commander 从原始需求中抽取的标准化研究目标
    "constraints": [ // 运行期间不得违反的资源、流程和科研约束
      "at most two attempts", // 当前列表中的一个具体值或 Artifact 引用
      "repair only the attributed stage", // 当前列表中的一个具体值或 Artifact 引用
      "same holdout and seeds" // 当前列表中的一个具体值或 Artifact 引用
    ], // 结束当前列表；逗号表示后面还有同级内容
    "success_criteria": [ // 最终结果必须满足的机器可判定指标阈值
      { // 开始当前结构化对象
        "metric": "validation_mae", // 被评测的指标名称
        "operator": "lte", // 阈值比较符；lte 表示实际值必须小于或等于目标
        "target": 0.1, // 该指标的目标值或阈值
        "unit": "mae" // 指标单位，防止不同量纲被错误比较
      }, // 结束当前结构化对象；逗号表示后面还有同级内容
      { // 开始当前结构化对象
        "metric": "p95_latency_ms", // 被评测的指标名称
        "operator": "lte", // 阈值比较符；lte 表示实际值必须小于或等于目标
        "target": 25.0, // 该指标的目标值或阈值
        "unit": "ms" // 指标单位，防止不同量纲被错误比较
      } // 结束当前结构化对象；逗号表示后面还有同级内容
    ], // 结束当前列表；逗号表示后面还有同级内容
    "context_refs": [ // 本次运行加载的基线、数据、规则或评测契约引用
      { // 开始当前结构化对象
        "ref": "context/evaluation_contract.json", // 证据或上下文文件的相对路径
        "role": "frozen_evaluator", // 该上下文在运行中的用途
        "sha256": "3333333333333333333333333333333333333333333333333333333333333333" // 文件内容哈希，用于确认运行期间上下文没有被篡改
      } // 结束当前结构化对象；逗号表示后面还有同级内容
    ] // 结束当前列表；逗号表示后面还有同级内容
