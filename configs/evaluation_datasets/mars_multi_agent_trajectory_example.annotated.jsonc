        ], // 结束当前列表；逗号表示后面还有同级内容
        "frontmatter": { // 符合 MARS Artifact Schema 的结构化元数据
          "schema": "proposal.v1", // 当前对象遵循的数据契约版本，用于选择正确的校验规则
          "project": "synthetic_regression", // 运行所使用的 Project Pack 名称
          "agent": "idea", // 产生 Artifact、事件或诊断的 Agent 名称
          "research_question": "Can feature pruning meet the latency target without exceeding the sealed MAE limit?", // Idea Agent 提出的研究问题
          "hypothesis": "Removing the four lowest-variance features will reduce latency while normalized training preserves validation MAE.", // 可通过实验验证或证伪的核心假设
          "novelty": "The candidate couples deterministic feature pruning with a quality-constrained evaluation contract.", // 相对于基线或常规方法的差异与新颖性说明
          "constraints": [ // 运行期间不得违反的资源、流程和科研约束
            "Maximum two attempts." // 当前列表中的一个具体值或 Artifact 引用
          ], // 结束当前列表；逗号表示后面还有同级内容
          "testable_predictions": [ // 假设成立时应当观察到的定量预测
            "validation_mae <= 0.10 and p95_latency_ms <= 25" // 当前列表中的一个具体值或 Artifact 引用
          ], // 结束当前列表；逗号表示后面还有同级内容
          "evidence_refs": [ // 支持当前输出或决策的证据路径列表
            "context/evaluation_contract.json" // 当前列表中的一个具体值或 Artifact 引用
